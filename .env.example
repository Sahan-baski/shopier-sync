# --- Sunucu ---
PORT=3000
# Admin paneline girerken istenecek basit sifre (tarayicidan HTTP Basic Auth ile sorulur)
ADMIN_USER=ahmet
ADMIN_PASSWORD=degistir-bunu

# --- Shopier ---
# Shopier panelinden: Hesap Yonetimi > Kisisel Erisim Anahtari (Personal Access Key)
# https://www.shopier.com/m/login.php -> Hesap Yonetimi -> Kisisel Erisim Anahtari
SHOPIER_ACCESS_KEY=

# Shopier REST API - tam OpenAPI semasi netlesti (developer.shopier.com).
# Stok guncelleme icin ayri bir endpoint yok: GET+PUT /products/{id} kullaniliyor,
# src/shopierClient.js bunu otomatik yapiyor - burada ekstra bir yol tanimlamana gerek yok.
SHOPIER_API_BASE=https://api.shopier.com/v1
SHOPIER_ORDER_WEBHOOK_SECRET=

# true iken gercek Shopier API'sine istek ATILMAZ, sadece ne gonderilecegi loglanir.
# Once is mantigini ve admin panelini test edip, sonra false yaparak canliya al.
DRY_RUN=true
