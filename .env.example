# --- Sunucu ---
PORT=3000
# Admin paneline girerken istenecek basit sifre (tarayicidan HTTP Basic Auth ile sorulur)
ADMIN_USER=ahmet
ADMIN_PASSWORD=degistir-bunu

# --- Shopier ---
# Shopier panelinden: Hesap Yonetimi > Kisisel Erisim Anahtari (Personal Access Key)
# https://www.shopier.com/m/login.php -> Hesap Yonetimi -> Kisisel Erisim Anahtari
SHOPIER_ACCESS_KEY=

# Shopier API'nin taban adresi ve stok guncelleme / siparis okuma yollari HENUZ TEYIT EDILMEDI.
# developer.shopier.com Claude'un web erisiminden robots.txt ile engellendigi icin
# tam endpoint / JSON semasi bu oturumda dogrulanamadi. Ahmet'in kendi hesabindan
# developer portalina girip asagidaki iki bilgiyi netlestirmesi gerekiyor:
#   1) Bir siparis olustugunda Shopier'in bize POST ettigi webhook/OSB gövdesinin alan adlari
#      (urun/varyasyon id'si, adet, siparis no vb.)
#   2) Bir varyasyonun stogunu API ile guncellemek icin endpoint + HTTP metodu + govde semasi
# Bu iki bilgi netlesince asagidaki degiskenleri doldurup src/shopierClient.js icindeki
# TODO yorumlarini tamamlamak yeterli - is mantigi (stockEngine.js) degismeyecek.
SHOPIER_API_BASE=https://api.shopier.com/v1
SHOPIER_STOCK_UPDATE_PATH=/TODO-gercek-yolu-buraya-yaz
SHOPIER_ORDER_WEBHOOK_SECRET=

# true iken gercek Shopier API'sine istek ATILMAZ, sadece ne gonderilecegi loglanir.
# Once is mantigini ve admin panelini test edip, sonra false yaparak canliya al.
DRY_RUN=true
